{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metaumbra.genome_selection_manifest.v1",
  "title": "MetaUmbra genome selection manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_by", "unit_definition", "selection", "inputs", "units", "artifacts", "warnings"],
  "properties": {
    "schema_version": {"const": "metaumbra.genome_selection_manifest.v1"},
    "generated_by": {
      "type": "object",
      "required": ["software", "version", "run_id", "generated_at"],
      "properties": {
        "software": {"const": "MetaUmbra"},
        "version": {"type": "string"},
        "run_id": {"type": "string"},
        "generated_at": {"type": "string", "format": "date-time"}
      }
    },
    "unit_definition": {
      "type": "object",
      "required": ["mode", "sample_id_column", "analysis_unit_column", "n_units"],
      "properties": {
        "mode": {"enum": ["all-samples", "per-sample", "metadata"]},
        "sample_id_column": {"type": "string"},
        "analysis_unit_column": {"type": ["string", "null"]},
        "n_units": {"type": "integer", "minimum": 1}
      }
    },
    "selection": {
      "type": "object",
      "required": ["default_genome_threshold", "available_genome_thresholds", "scoring_method"],
      "properties": {
        "default_genome_threshold": {"enum": ["q0.05", "q0.01"]},
        "available_genome_thresholds": {"const": ["q0.05", "q0.01"]},
        "scoring_method": {"type": "string"}
      }
    },
    "inputs": {"type": "object"},
    "units": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["sample_ids", "n_samples", "genome_ids_q005", "genome_ids_q001"],
        "properties": {
          "sample_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "n_samples": {"type": "integer", "minimum": 1},
          "genome_ids_q005": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "genome_ids_q001": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "artifacts": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
